{
  "snippets_file": "def : > [!abstract] Definition\ninfo : > [!info] \nue : ü\noe : ö\nae : ä",
  "snippets": [
    "def : > [!abstract] Definition",
    "info : > [!info] ",
    "ue : ü",
    "oe : ö",
    "ae : ä"
